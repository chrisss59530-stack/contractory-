#include "ContractoryMissionSaveManager.h"
#include "Net/UnrealNetwork.h"

AContractoryMissionSaveManager::AContractoryMissionSaveManager()
{
    PrimaryActorTick.bCanEverTick = false;
    bReplicates = true;
    bAlwaysRelevant = true; // Temporary; tighten for per-player data before multiplayer release.
    SetReplicateMovement(false);
}

void AContractoryMissionSaveManager::GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const
{
    Super::GetLifetimeReplicatedProps(OutLifetimeProps);
    DOREPLIFETIME(AContractoryMissionSaveManager, PlayerStates);
}

void AContractoryMissionSaveManager::PreSaveGame_Implementation(int32 SaveVersion, int32 GameVersion) {}
void AContractoryMissionSaveManager::PostSaveGame_Implementation(int32 SaveVersion, int32 GameVersion) {}
void AContractoryMissionSaveManager::PreLoadGame_Implementation(int32 SaveVersion, int32 GameVersion) {}
void AContractoryMissionSaveManager::PostLoadGame_Implementation(int32 SaveVersion, int32 GameVersion) {}
void AContractoryMissionSaveManager::GatherDependencies_Implementation(TArray<UObject*>& OutDependentObjects) {}
bool AContractoryMissionSaveManager::ShouldSave_Implementation() const { return true; }
bool AContractoryMissionSaveManager::NeedTransform_Implementation() { return false; }

FContractoryPlayerMissionState* AContractoryMissionSaveManager::FindOrAddServerPlayer(const FString& TrustedPlayerKey)
{
    if (!HasAuthority() || TrustedPlayerKey.IsEmpty()) return nullptr;
    for (FContractoryPlayerMissionState& State : PlayerStates)
    {
        if (State.PlayerKey == TrustedPlayerKey) return &State;
    }
    FContractoryPlayerMissionState& Added = PlayerStates.AddDefaulted_GetRef();
    Added.PlayerKey = TrustedPlayerKey;
    ForceNetUpdate();
    return &Added;
}

const FContractoryPlayerMissionState* AContractoryMissionSaveManager::FindPlayer(const FString& PlayerKey) const
{
    for (const FContractoryPlayerMissionState& State : PlayerStates)
    {
        if (State.PlayerKey == PlayerKey) return &State;
    }
    return nullptr;
}

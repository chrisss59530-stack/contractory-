#include "ContractoryDeliveryBuildable.h"

#include "Components/SceneComponent.h"

#include "FGInventoryComponent.h"
#include "FGFactoryConnectionComponent.h"
#include "FGCharacterPlayer.h"
#include "FGPlayerState.h"

AContractoryDeliveryBuildable::
AContractoryDeliveryBuildable()
{
    DeliveryInventory =
        CreateDefaultSubobject<UFGInventoryComponent>(
            TEXT("ContractoryDeliveryInventory")
        );

    DeliveryInputAnchor =
        CreateDefaultSubobject<USceneComponent>(
            TEXT("ContractoryDeliveryInputAnchor")
        );

    DeliveryInputAnchor->SetupAttachment(
        RootComponent
    );

    DeliveryInputAnchor->SetRelativeLocation(
        FVector(0.0f, 110.0f, 71.3f)
    );

    DeliveryInputAnchor->SetRelativeRotation(
        FRotator(0.0f, 90.0f, 0.0f)
    );

    DeliveryInputConnection =
        CreateDefaultSubobject<UFGFactoryConnectionComponent>(
            TEXT("ContractoryDeliveryInput")
        );

    DeliveryInputConnection->SetupAttachment(
        DeliveryInputAnchor
    );

    DeliveryInputConnection->SetMobility(
        EComponentMobility::Movable
    );

    DeliveryInputConnection->SetDirection(
        EFactoryConnectionDirection::FCD_INPUT
    );

    DeliveryInputConnection->SetInventory(
        DeliveryInventory
    );

    DeliveryInputConnection->SetInventoryAccessIndex(
        0
    );
}

void AContractoryDeliveryBuildable::BeginPlay()
{
    Super::BeginPlay();

    if (DeliveryInventory)
    {
        if (
            HasAuthority() &&
            DeliveryInventory->GetSizeLinear() != 1
        )
        {
            DeliveryInventory->Resize(1);
        }
    }

    if (
        DeliveryInputConnection &&
        DeliveryInventory
    )
    {
        DeliveryInputConnection->SetDirection(
            EFactoryConnectionDirection::FCD_INPUT
        );

        DeliveryInputConnection->SetInventory(
            DeliveryInventory
        );

        DeliveryInputConnection->SetInventoryAccessIndex(
            0
        );
    }

    UE_LOG(
        LogTemp,
        Log,
        TEXT(
            "[Contractory] Livraison ready : "
            "Inventory=%s Connection=%s BoundPlayer=%s"
        ),
        DeliveryInventory
            ? *DeliveryInventory->GetName()
            : TEXT("NONE"),
        DeliveryInputConnection
            ? *DeliveryInputConnection->GetName()
            : TEXT("NONE"),
        BoundPlayerKey.IsEmpty()
            ? TEXT("NONE")
            : *BoundPlayerKey
    );
}

bool AContractoryDeliveryBuildable::
IsUseable_Implementation() const
{
    return true;
}

void AContractoryDeliveryBuildable::
OnUse_Implementation(
    AFGCharacterPlayer* byCharacter,
    const FUseState& state
)
{
    if (!HasAuthority() || !byCharacter)
    {
        return;
    }

    AFGPlayerState* PlayerState =
        byCharacter->GetControllingPlayerState();

    if (!PlayerState)
    {
        return;
    }

    const FString PlayerKey =
        PlayerState->GetUserID();

    if (PlayerKey.IsEmpty())
    {
        return;
    }

    if (BoundPlayerKey.IsEmpty())
    {
        BoundPlayerKey = PlayerKey;

        ForceNetUpdate();

        UE_LOG(
            LogTemp,
            Log,
            TEXT(
                "[Contractory] Livraison %s linked to player %s"
            ),
            *GetName(),
            *BoundPlayerKey
        );

        return;
    }

    if (BoundPlayerKey == PlayerKey)
    {
        UE_LOG(
            LogTemp,
            Log,
            TEXT(
                "[Contractory] Livraison %s already linked "
                "to this player."
            ),
            *GetName()
        );

        return;
    }

    UE_LOG(
        LogTemp,
        Warning,
        TEXT(
            "[Contractory] Livraison %s belongs "
            "to another Contractory player."
        ),
        *GetName()
    );
}

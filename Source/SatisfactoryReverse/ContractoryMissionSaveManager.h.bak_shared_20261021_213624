#pragma once

#include "CoreMinimal.h"
#include "GameFramework/Actor.h"
#include "FGSaveInterface.h"
#include "ContractoryMissionManager.h"
#include "ContractoryMissionSaveManager.generated.h"

// A unique, stable player key must be resolved by trusted SERVER code.
// Do not use display names or client-provided strings as identity.
USTRUCT(BlueprintType)
struct FContractoryPlayerMissionState
{
    GENERATED_BODY()

    UPROPERTY(SaveGame, VisibleAnywhere, Category="Contractory|Missions")
    FString PlayerKey;

    UPROPERTY(SaveGame, VisibleAnywhere, Category="Contractory|Missions")
    FContractoryMissionSession Session;

    UPROPERTY(SaveGame, VisibleAnywhere, Category="Contractory|Missions")
    int32 RotationIndex = 0;
};

// STORAGE FOUNDATION ONLY. It must later be spawned once by server-side
// game-world startup and integrated with Satisfactory's save discovery/restore.
// No client mutation RPC is exposed.
UCLASS(NotPlaceable)
class SATISFACTORYREVERSE_API AContractoryMissionSaveManager : public AActor, public IFGSaveInterface
{
    GENERATED_BODY()

public:
    AContractoryMissionSaveManager();

    virtual void GetLifetimeReplicatedProps(TArray<FLifetimeProperty>& OutLifetimeProps) const override;

    virtual void PreSaveGame_Implementation(int32 SaveVersion, int32 GameVersion) override;
    virtual void PostSaveGame_Implementation(int32 SaveVersion, int32 GameVersion) override;
    virtual void PreLoadGame_Implementation(int32 SaveVersion, int32 GameVersion) override;
    virtual void PostLoadGame_Implementation(int32 SaveVersion, int32 GameVersion) override;
    virtual void GatherDependencies_Implementation(TArray<UObject*>& OutDependentObjects) override;
    virtual bool ShouldSave_Implementation() const override;
    virtual bool NeedTransform_Implementation() override;

    // Trusted server C++ only. No client-requested PlayerKey accepted here.
    FContractoryPlayerMissionState* FindOrAddServerPlayer(const FString& TrustedPlayerKey);
    const FContractoryPlayerMissionState* FindPlayer(const FString& PlayerKey) const;

private:
    // Replication is a preliminary implementation, NOT per-player relevancy filtering.
    // No UFUNCTION exposes other players' balances to a UI.
    UPROPERTY(SaveGame, Replicated)
    TArray<FContractoryPlayerMissionState> PlayerStates;
};

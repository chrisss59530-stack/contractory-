#pragma once

#include "CoreMinimal.h"
#include "Components/ActorComponent.h"
#include "ContractoryTerminalAnimatorComponent.generated.h"

class UStaticMeshComponent;

UCLASS(ClassGroup=(Contractory), meta=(BlueprintSpawnableComponent))
class SATISFACTORYREVERSE_API UContractoryTerminalAnimatorComponent : public UActorComponent
{
    GENERATED_BODY()

public:
    UContractoryTerminalAnimatorComponent();

protected:
    virtual void BeginPlay() override;

public:
    virtual void TickComponent(
        float DeltaTime,
        ELevelTick TickType,
        FActorComponentTickFunction* ThisTickFunction
    ) override;

    // =========================================================
    // SCANNER
    // =========================================================

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Scanner")
    bool bAnimateScanner = true;

    // Mouvement vertical en centimetres
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Scanner")
    float ScannerAmplitude = 7.0f;

    // Nombre de cycles par seconde
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Scanner")
    float ScannerSpeed = 0.35f;

    // =========================================================
    // TIROIR
    // =========================================================

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Drawer")
    bool bAnimateDrawer = true;

    // Distance d'ouverture vers l'avant (-Y)
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Drawer")
    float DrawerTravel = 35.5f;

    // Cycle complet : ferme -> ouvre -> pause -> ferme
    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Drawer")
    float DrawerCycleDuration = 6.0f;

    // =========================================================
    // GYROPHARE
    // =========================================================

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Beacon")
    bool bAnimateBeacon = true;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Contractory|Terminal|Beacon")
    float BeaconDegreesPerSecond = 240.0f;

private:
    UPROPERTY(Transient)
    TObjectPtr<UStaticMeshComponent> ScannerComponent;

    UPROPERTY(Transient)
    TObjectPtr<UStaticMeshComponent> BeaconComponent;

    UPROPERTY(Transient)
    TArray<TObjectPtr<UStaticMeshComponent>> DrawerComponents;

    FVector ScannerBaseLocation = FVector::ZeroVector;
    FRotator BeaconBaseRotation = FRotator::ZeroRotator;

    TArray<FVector> DrawerBaseLocations;

    float AnimationTime = 0.0f;

    void FindAnimatedComponents();
};

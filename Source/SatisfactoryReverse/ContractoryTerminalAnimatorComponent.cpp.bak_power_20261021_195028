#include "ContractoryTerminalAnimatorComponent.h"

#include "ContractoryPoweredBuildable.h"
#include "Components/StaticMeshComponent.h"
#include "GameFramework/Actor.h"
#include "Math/UnrealMathUtility.h"


UContractoryTerminalAnimatorComponent::UContractoryTerminalAnimatorComponent()
{
    PrimaryComponentTick.bCanEverTick = true;
    PrimaryComponentTick.bStartWithTickEnabled = true;
    bAutoActivate = true;
}


// ============================================================
// BEGIN PLAY
// ============================================================

void UContractoryTerminalAnimatorComponent::BeginPlay()
{
    Super::BeginPlay();

    // Ensure the animator is active when the Terminal enters the world.
    Activate(true);
    SetComponentTickEnabled(true);

    AnimationTime = 0.0f;

    FindAnimatedComponents();

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("[Contractory Terminal] Animator initialise | Scanner=%s | Beacon=%s | DrawerParts=%d"),
        ScannerComponent ? TEXT("OK") : TEXT("ABSENT"),
        BeaconComponent ? TEXT("OK") : TEXT("ABSENT"),
        DrawerComponents.Num()
    );
}


// ============================================================
// RECHERCHE DES PIECES DU MODELE
// ============================================================

void UContractoryTerminalAnimatorComponent::FindAnimatedComponents()
{
    ScannerComponent = nullptr;
    BeaconComponent = nullptr;

    DrawerComponents.Reset();
    DrawerBaseLocations.Reset();

    AActor* OwnerActor = GetOwner();

    if (!OwnerActor)
    {
        return;
    }

    TArray<UStaticMeshComponent*> MeshComponents;
    OwnerActor->GetComponents<UStaticMeshComponent>(MeshComponents);

    for (UStaticMeshComponent* Component : MeshComponents)
    {
        if (!Component)
        {
            continue;
        }

        FString SearchName = Component->GetName();

        if (Component->GetStaticMesh())
        {
            SearchName += TEXT(" ");
            SearchName += Component->GetStaticMesh()->GetName();
        }


        // ----------------------------------------------------
        // SCANNER
        // ----------------------------------------------------

        if (!ScannerComponent &&
            SearchName.Contains(TEXT("Scanner_Ring")))
        {
            ScannerComponent = Component;
            ScannerBaseLocation = Component->GetRelativeLocation();

            UE_LOG(
                LogTemp,
                Warning,
                TEXT("[Contractory Terminal] Scanner trouve : %s"),
                *Component->GetName()
            );

            continue;
        }


        // ----------------------------------------------------
        // GYROPHARE
        // ----------------------------------------------------

        if (!BeaconComponent &&
            SearchName.Contains(TEXT("Top_Beacon")))
        {
            BeaconComponent = Component;
            BeaconBaseRotation = Component->GetRelativeRotation();

            UE_LOG(
                LogTemp,
                Warning,
                TEXT("[Contractory Terminal] Beacon trouve : %s"),
                *Component->GetName()
            );

            continue;
        }


        // ----------------------------------------------------
        // TIROIR MOBILE
        //
        // Les elements "Drawer_*" principaux restent fixes :
        // ils constituent le logement externe.
        //
        // On anime le tiroir interieur "Tiroir_*"
        // ainsi que sa facade et sa poignee.
        // ----------------------------------------------------

        const bool bIsInnerDrawer =
            SearchName.Contains(TEXT("Tiroir_"));

        const bool bIsDrawerFront =
            SearchName.Contains(TEXT("Drawer_Front"));

        const bool bIsDrawerHandle =
            SearchName.Contains(TEXT("Drawer_Handle"));

        if (bIsInnerDrawer ||
            bIsDrawerFront ||
            bIsDrawerHandle)
        {
            DrawerComponents.Add(Component);
            DrawerBaseLocations.Add(Component->GetRelativeLocation());

            UE_LOG(
                LogTemp,
                Warning,
                TEXT("[Contractory Terminal] Piece tiroir : %s"),
                *Component->GetName()
            );
        }
    }
}


// ============================================================
// TICK ANIMATIONS
// ============================================================

void UContractoryTerminalAnimatorComponent::TickComponent(
    float DeltaTime,
    ELevelTick TickType,
    FActorComponentTickFunction* ThisTickFunction
)
{
    Super::TickComponent(
        DeltaTime,
        TickType,
        ThisTickFunction
    );

    AnimationTime += DeltaTime;


    // ========================================================
    // SCANNER
    // Mouvement vertical sinusoidal
    // ========================================================

    if (ScannerComponent)
    {
        if (bAnimateScanner)
        {
            const float Phase =
                AnimationTime *
                ScannerSpeed *
                2.0f *
                PI;

            const float ZOffset =
                FMath::Sin(Phase) *
                ScannerAmplitude;

            ScannerComponent->SetRelativeLocation(
                ScannerBaseLocation +
                FVector(0.0f, 0.0f, ZOffset)
            );
        }
        else
        {
            ScannerComponent->SetRelativeLocation(
                ScannerBaseLocation
            );
        }
    }


    // ========================================================
    // TIROIR
    // ========================================================

    if (DrawerComponents.Num() > 0 &&
        DrawerComponents.Num() == DrawerBaseLocations.Num())
    {
        float OpenAlpha = 0.0f;

        if (bAnimateDrawer &&
            DrawerCycleDuration > KINDA_SMALL_NUMBER)
        {
            const float CycleTime =
                FMath::Fmod(
                    AnimationTime,
                    DrawerCycleDuration
                );

            const float Phase =
                CycleTime /
                DrawerCycleDuration;


            // 0.00 -> 0.15 : ferme
            if (Phase < 0.15f)
            {
                OpenAlpha = 0.0f;
            }

            // 0.15 -> 0.35 : ouverture
            else if (Phase < 0.35f)
            {
                const float T =
                    (Phase - 0.15f) /
                    0.20f;

                OpenAlpha =
                    FMath::InterpEaseInOut(
                        0.0f,
                        1.0f,
                        T,
                        2.0f
                    );
            }

            // 0.35 -> 0.65 : ouvert
            else if (Phase < 0.65f)
            {
                OpenAlpha = 1.0f;
            }

            // 0.65 -> 0.85 : fermeture
            else if (Phase < 0.85f)
            {
                const float T =
                    (Phase - 0.65f) /
                    0.20f;

                OpenAlpha =
                    FMath::InterpEaseInOut(
                        1.0f,
                        0.0f,
                        T,
                        2.0f
                    );
            }

            // 0.85 -> 1.00 : ferme
            else
            {
                OpenAlpha = 0.0f;
            }
        }


        const FVector DrawerOffset(
            0.0f,
            -DrawerTravel * OpenAlpha,
            0.0f
        );


        for (int32 Index = 0;
             Index < DrawerComponents.Num();
             ++Index)
        {
            UStaticMeshComponent* Component =
                DrawerComponents[Index];

            if (!Component)
            {
                continue;
            }

            Component->SetRelativeLocation(
                DrawerBaseLocations[Index] +
                DrawerOffset
            );
        }
    }


    // ========================================================
    // GYROPHARE
    // Rotation autour de Z = Yaw Unreal
    // ========================================================

    if (BeaconComponent)
    {
        if (bAnimateBeacon)
        {
            FRotator NewRotation =
                BeaconBaseRotation;

            NewRotation.Yaw +=
                FMath::Fmod(
                    AnimationTime *
                    BeaconDegreesPerSecond,
                    360.0f
                );

            BeaconComponent->SetRelativeRotation(
                NewRotation
            );
        }
        else
        {
            BeaconComponent->SetRelativeRotation(
                BeaconBaseRotation
            );
        }
    }
}

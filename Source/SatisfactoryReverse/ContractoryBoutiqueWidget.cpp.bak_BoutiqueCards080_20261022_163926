// BOUTON D'ACHAT
// ============================================================

void UContractoryBoutiqueBuyButton::Configure(
    UContractoryMissionRemoteCallObject* InMissionRCO,
    const FString& InSchematicClassPath
)
{
    MissionRCO = InMissionRCO;
    SchematicClassPath = InSchematicClassPath;

    OnClicked.RemoveDynamic(
        this,
        &UContractoryBoutiqueBuyButton::HandleClicked
    );

    OnClicked.AddDynamic(
        this,
        &UContractoryBoutiqueBuyButton::HandleClicked
    );
}

void UContractoryBoutiqueBuyButton::HandleClicked()
{
    if (!MissionRCO ||
        SchematicClassPath.IsEmpty())
    {
        return;
    }

    MissionRCO->Server_PurchaseBoutiqueSchematic(
        SchematicClassPath
    );
}


// ============================================================
// WIDGET BOUTIQUE
// ============================================================

void UContractoryBoutiqueWidget::NativeConstruct()
{
    Super::NativeConstruct();

    if (!MainBox)
    {
        BuildBoutiqueInterface();
    }

    BindMissionRemoteCallObject();

    if (UWorld* World = GetWorld())
    {
        World->GetTimerManager().SetTimer(
            BoutiquePollTimer,
            this,
            &UContractoryBoutiqueWidget::PollBoutiqueState,
            0.5f,
            true
        );
    }

    RefreshBoutiqueInterface();
}

void UContractoryBoutiqueWidget::NativeDestruct()
{
    if (UWorld* World = GetWorld())
    {
        World->GetTimerManager().ClearTimer(
            BoutiquePollTimer
        );
    }

    if (MissionRCO)
    {
        MissionRCO->OnMissionStateUpdated.RemoveAll(this);
        MissionRCO->OnBoutiquePurchaseResult.RemoveAll(this);
    }

    Super::NativeDestruct();
}

void UContractoryBoutiqueWidget::BuildBoutiqueInterface()
{
    if (!WidgetTree)
    {
        return;
    }

    MainBox =
        WidgetTree->ConstructWidget<UVerticalBox>(
            UVerticalBox::StaticClass(),
            TEXT("ContractoryBoutiqueMain")
        );

    WidgetTree->RootWidget = MainBox;

    // --------------------------------------------------------
    // TITRE
    // --------------------------------------------------------

    UTextBlock* Title =
        WidgetTree->ConstructWidget<UTextBlock>(
            UTextBlock::StaticClass(),
            TEXT("BoutiqueTitle")
        );

    Title->SetText(
        FText::FromString(
            TEXT("BOUTIQUE CONTRACTORY")
        )
    );

    MainBox->AddChildToVerticalBox(Title);

    // --------------------------------------------------------
    // CREDITS
    // --------------------------------------------------------

    CreditsText =
        WidgetTree->ConstructWidget<UTextBlock>(
            UTextBlock::StaticClass(),
            TEXT("BoutiqueCredits")
        );

    CreditsText->SetText(
        FText::FromString(
            TEXT("Crédits FICSIT : chargement...")
        )
    );

    MainBox->AddChildToVerticalBox(CreditsText);

    // --------------------------------------------------------
    // MESSAGE RESULTAT
    // --------------------------------------------------------

    ResultText =
        WidgetTree->ConstructWidget<UTextBlock>(
            UTextBlock::StaticClass(),
            TEXT("BoutiqueResult")
        );

    ResultText->SetText(
        FText::FromString(
            TEXT("Sélectionnez une recherche à acheter.")
        )
    );

    ResultText->SetAutoWrapText(true);

    MainBox->AddChildToVerticalBox(ResultText);

    // --------------------------------------------------------
    // SCROLL CATALOGUE
    // --------------------------------------------------------

    CatalogueScroll =
        WidgetTree->ConstructWidget<UScrollBox>(
            UScrollBox::StaticClass(),
            TEXT("BoutiqueCatalogue")
        );

    MainBox->AddChildToVerticalBox(CatalogueScroll);

    EntryStatusTexts.Reset();
    EntryButtonTexts.Reset();
    BuyButtons.Reset();
    SchematicClasses.Reset();
    SchematicPaths.Reset();
    EntryPrices.Reset();

    const TArray<FContractoryBoutiqueEntry> Catalogue =
        UContractoryBoutiqueCatalog::GetCatalogue();

    FString LastCategory;

    for (int32 Index = 0;
         Index < Catalogue.Num();
         ++Index)
    {
        const FContractoryBoutiqueEntry& Entry =
            Catalogue[Index];

        // ----------------------------------------------------
        // TITRE DE CATEGORIE
        // ----------------------------------------------------

        if (Entry.Category != LastCategory)
        {
            LastCategory = Entry.Category;

            UTextBlock* CategoryTitle =
                WidgetTree->ConstructWidget<UTextBlock>(
                    UTextBlock::StaticClass()
                );

            CategoryTitle->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT("=== %s ==="),
                        *Entry.Category
                    )
                )
            );

            CatalogueScroll->AddChild(
                CategoryTitle
            );
        }

        // ----------------------------------------------------
        // CHARGEMENT DU VRAI SCHEMATIC VANILLA
        // ----------------------------------------------------

        TSubclassOf<UFGSchematic> SchematicClass =
            LoadClass<UFGSchematic>(
                nullptr,
                *Entry.SchematicClassPath
            );

        SchematicClasses.Add(SchematicClass);
        SchematicPaths.Add(Entry.SchematicClassPath);
        EntryPrices.Add(Entry.PriceCredits);

        // ----------------------------------------------------
        // LIGNE
        // ----------------------------------------------------

        UHorizontalBox* Row =
            WidgetTree->ConstructWidget<UHorizontalBox>(
                UHorizontalBox::StaticClass()
            );

        CatalogueScroll->AddChild(Row);

        // ----------------------------------------------------
        // ICONE VANILLA
        // ----------------------------------------------------

        USizeBox* IconSize =
            WidgetTree->ConstructWidget<USizeBox>(
                USizeBox::StaticClass()
            );

        IconSize->SetWidthOverride(48.0f);
        IconSize->SetHeightOverride(48.0f);

        UImage* IconImage =
            WidgetTree->ConstructWidget<UImage>(
                UImage::StaticClass()
            );

        IconSize->AddChild(IconImage);

        Row->AddChildToHorizontalBox(
            IconSize
        );

        // ----------------------------------------------------
        // TEXTE NOM + PRIX/ETAT
        // ----------------------------------------------------

        UVerticalBox* Information =
            WidgetTree->ConstructWidget<UVerticalBox>(
                UVerticalBox::StaticClass()
            );

        Row->AddChildToHorizontalBox(
            Information
        );

        UTextBlock* NameText =
            WidgetTree->ConstructWidget<UTextBlock>(
                UTextBlock::StaticClass()
            );

        UTextBlock* StatusText =
            WidgetTree->ConstructWidget<UTextBlock>(
                UTextBlock::StaticClass()
            );

        StatusText->SetAutoWrapText(true);

        Information->AddChildToVerticalBox(
            NameText
        );

        Information->AddChildToVerticalBox(
            StatusText
        );

        EntryStatusTexts.Add(StatusText);

        // ----------------------------------------------------
        // BOUTON
        // ----------------------------------------------------

        UContractoryBoutiqueBuyButton* BuyButton =
            WidgetTree->ConstructWidget<
                UContractoryBoutiqueBuyButton
            >(
                UContractoryBoutiqueBuyButton::StaticClass()
            );

        UTextBlock* BuyButtonText =
            WidgetTree->ConstructWidget<UTextBlock>(
                UTextBlock::StaticClass()
            );

        BuyButtonText->SetText(
            FText::FromString(
                TEXT("ACHETER")
            )
        );

        BuyButton->AddChild(BuyButtonText);

        Row->AddChildToHorizontalBox(
            BuyButton
        );

        BuyButtons.Add(BuyButton);
        EntryButtonTexts.Add(BuyButtonText);

        // ----------------------------------------------------
        // DONNEES VANILLA D'AFFICHAGE
        // ----------------------------------------------------

        if (SchematicClass)
        {
            NameText->SetText(
                UFGSchematic::GetSchematicDisplayName(
                    SchematicClass
                )
            );
        const FSlateBrush ItemIcon =
            UFGSchematic::GetItemIcon(
                SchematicClass
            );

        IconImage->SetBrush(ItemIcon);

            Row->SetToolTipText(
                UFGSchematic::GetSchematicDescription(
                    SchematicClass
                )
            );
        }
        else
        {
            NameText->SetText(
                FText::FromString(
                    Entry.SchematicClassPath
                )
            );
        }

        StatusText->SetText(
            FText::FromString(
                FString::Printf(
                    TEXT("Prix : %d Crédits FICSIT"),
                    Entry.PriceCredits
                )
            )
        );
    }
}

void UContractoryBoutiqueWidget::
BindMissionRemoteCallObject()
{
    AFGPlayerController* PlayerController =
        Cast<AFGPlayerController>(
            GetOwningPlayer()
        );

    if (!PlayerController)
    {
        return;
    }

    MissionRCO =
        Cast<UContractoryMissionRemoteCallObject>(
            PlayerController->GetRemoteCallObjectOfClass(
                UContractoryMissionRemoteCallObject::
                    StaticClass()
            )
        );

    if (!MissionRCO)
    {
        return;
    }

    MissionRCO->OnMissionStateUpdated.RemoveAll(this);
    MissionRCO->OnBoutiquePurchaseResult.RemoveAll(this);

    MissionRCO->OnMissionStateUpdated.AddUObject(
        this,
        &UContractoryBoutiqueWidget::
            RefreshBoutiqueInterface
    );

    MissionRCO->OnBoutiquePurchaseResult.AddUObject(
        this,
        &UContractoryBoutiqueWidget::
            HandleBoutiquePurchaseResult
    );

    for (int32 Index = 0;
         Index < BuyButtons.Num();
         ++Index)
    {
        if (!BuyButtons.IsValidIndex(Index) ||
            !SchematicPaths.IsValidIndex(Index))
        {
            continue;
        }

        if (BuyButtons[Index])
        {
            BuyButtons[Index]->Configure(
                MissionRCO,
                SchematicPaths[Index]
            );
        }
    }

    MissionRCO->Server_RequestMissionState();
}

void UContractoryBoutiqueWidget::
PollBoutiqueState()
{
    if (!MissionRCO)
    {
        BindMissionRemoteCallObject();
    }

    if (MissionRCO)
    {
        MissionRCO->Server_RequestMissionState();
    }

    RefreshBoutiqueInterface();
}

void UContractoryBoutiqueWidget::
RefreshBoutiqueInterface()
{
    const int32 Credits =
        MissionRCO
            ? MissionRCO->GetCachedCredits()
            : 0;

    if (CreditsText)
    {
        CreditsText->SetText(
            FText::FromString(
                FString::Printf(
                    TEXT("Crédits FICSIT : %d"),
                    Credits
                )
            )
        );
    }

    AFGSchematicManager* SchematicManager =
        AFGSchematicManager::Get(
            GetWorld()
        );

    for (int32 Index = 0;
         Index < SchematicClasses.Num();
         ++Index)
    {
        if (!EntryStatusTexts.IsValidIndex(Index) ||
            !EntryButtonTexts.IsValidIndex(Index) ||
            !BuyButtons.IsValidIndex(Index) ||
            !EntryPrices.IsValidIndex(Index))
        {
            continue;
        }

        UTextBlock* StatusText =
            EntryStatusTexts[Index];

        UTextBlock* ButtonText =
            EntryButtonTexts[Index];

        UContractoryBoutiqueBuyButton* BuyButton =
            BuyButtons[Index];

        const int32 Price =
            EntryPrices[Index];

        TSubclassOf<UFGSchematic> SchematicClass =
            SchematicClasses[Index];

        if (!StatusText ||
            !ButtonText ||
            !BuyButton)
        {
            continue;
        }

        if (!MissionRCO ||
            !SchematicManager ||
            !SchematicClass)
        {
            StatusText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT("Prix : %d | INDISPONIBLE"),
                        Price
                    )
                )
            );

            ButtonText->SetText(
                FText::FromString(
                    TEXT("INDISPONIBLE")
                )
            );

            BuyButton->SetIsEnabled(false);
            continue;
        }

        const bool bPurchased =
            SchematicManager->IsSchematicPurchased(
                SchematicClass
            );

        if (bPurchased)
        {
            StatusText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT("Prix : %d | ACHETÉ"),
                        Price
                    )
                )
            );

            ButtonText->SetText(
                FText::FromString(
                    TEXT("ACHETÉ")
                )
            );

            BuyButton->SetIsEnabled(false);
            continue;
        }

        const bool bDependenciesMet =
            UFGSchematic::CanGiveAccessToSchematic(
                SchematicClass,
                GetWorld()
            );

        if (!bDependenciesMet)
        {
            StatusText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT("Prix : %d | VERROUILLÉ"),
                        Price
                    )
                )
            );

            ButtonText->SetText(
                FText::FromString(
                    TEXT("VERROUILLÉ")
                )
            );

            BuyButton->SetIsEnabled(false);
            continue;
        }

        if (Credits < Price)
        {
            StatusText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT(
                            "Prix : %d | Crédits insuffisants"
                        ),
                        Price
                    )
                )
            );

            ButtonText->SetText(
                FText::FromString(
                    TEXT("CRÉDITS")
                )
            );

            BuyButton->SetIsEnabled(false);
            continue;
        }

        StatusText->SetText(
            FText::FromString(
                FString::Printf(
                    TEXT("Prix : %d Crédits FICSIT"),
                    Price
                )
            )
        );

        ButtonText->SetText(
            FText::FromString(
                TEXT("ACHETER")
            )
        );

        BuyButton->SetIsEnabled(true);
    }
}

void UContractoryBoutiqueWidget::
HandleBoutiquePurchaseResult(
    bool bSuccess,
    int32 RemainingCredits,
    const FString& SchematicClassPath,
    const FString& FailureReason
)
{
    if (ResultText)
    {
        if (bSuccess)
        {
            TSubclassOf<UFGSchematic> PurchasedClass =
                LoadClass<UFGSchematic>(
                    nullptr,
                    *SchematicClassPath
                );

            const FString DisplayName =
                PurchasedClass
                    ? UFGSchematic::
                        GetSchematicDisplayName(
                            PurchasedClass
                        ).ToString()
                    : SchematicClassPath;

            ResultText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT(
                            "ACHAT VALIDÉ : %s | Crédits restants : %d"
                        ),
                        *DisplayName,
                        RemainingCredits
                    )
                )
            );
        }
        else
        {
            ResultText->SetText(
                FText::FromString(
                    FString::Printf(
                        TEXT(
                            "ACHAT REFUSÉ : %s"
                        ),
                        *FailureReason
                    )
                )
            );
        }
    }

    RefreshBoutiqueInterface();
}